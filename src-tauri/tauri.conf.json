{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "零码密码与证书工具箱",
  "version": "0.1.0",
  "identifier": "top.zerocodex.crypto",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "零码密码与证书工具箱",
        "width": 1360,
        "height": 880,
        "minWidth": 1120,
        "minHeight": 720,
        "resizable": true,
        "maximized": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}
